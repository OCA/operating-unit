<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.operating.unit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="access_rights" position="after">
                <setting
                    id="new_user_operating_units"
                    string="Default Operating Units"
                    help="Operating units granted to new users of this company"
                    groups="operating_unit.group_multi_operating_unit"
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                                for="new_user_operating_unit_ids"
                                string="Allowed"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                name="new_user_operating_unit_ids"
                                widget="many2many_tags"
                                domain="[('company_id', '=', company_id)]"
                            />
                        </div>
                        <div class="row">
                            <label
                                for="new_user_default_operating_unit_id"
                                string="Default"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                name="new_user_default_operating_unit_id"
                                domain="[('id', 'in', new_user_operating_unit_ids)]"
                            />
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
