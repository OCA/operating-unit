<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="module_operating_units" model="ir.module.category">
        <field name="name">Operating Units</field>
        <field name="sequence" eval="30" />
    </record>

    <record id="res_groups_privilege_operating_units" model="res.groups.privilege">
        <field name="name">Operating Units Group</field>
        <field name="category_id" ref="module_operating_units" />
    </record>

    <record id="group_multi_operating_unit" model="res.groups">
        <field name="name">Multiple Operating Unit</field>
        <field name="privilege_id" ref="res_groups_privilege_operating_units" />
    </record>
    <record id="group_manager_operating_unit" model="res.groups">
        <field name="name">Manager of Operating Units</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_multi_operating_unit'))]"
        />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
        <field name="privilege_id" ref="res_groups_privilege_operating_units" />
    </record>
</odoo>
